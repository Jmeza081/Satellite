{
	"name": "theme-satellite",
	"version": "2.18.0",
	"displayName": "Satellite",
	"description": "A space-inspired theme for VS Code, in dark and light, with high-contrast variants",
	"license": "MIT",
	"scripts": {
		"dev": "node ./scripts/dev.js",
		"build": "node ./scripts/build.js",
		"validate": "node ./scripts/validate.js",
		"coverage": "node ./scripts/validate.js --coverage",
		"verify": "node ./scripts/verify.js --strict",
		"fixtures": "node ./scripts/fixtures.js",
		"verify:report": "node ./scripts/verify.js",
		"update-color-keys": "node ./scripts/update-color-keys.js",
		"test": "node ./scripts/test.js && npm run build && npm run validate && npm run verify && npm run fixtures",
		"package": "vsce package -o ./bin/satellite.vsix",
		"vscode:prepublish": "npm run build && npm run validate && npm run verify && npm run fixtures"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Jmeza081/Satellite"
	},
	"bugs": {
		"url": "https://github.com/Jmeza081/Satellite/issues"
	},
	"engines": {
		"vscode": "^1.13.0"
	},
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "Satellite",
				"uiTheme": "vs-dark",
				"path": "./theme/satellite.json"
			},
			{
				"label": "Satellite Daybreak",
				"uiTheme": "vs",
				"path": "./theme/satellite-daybreak.json"
			},
			{
				"label": "Satellite High Contrast",
				"uiTheme": "hc-black",
				"path": "./theme/satellite-orbit-hc.json"
			},
			{
				"label": "Satellite Daybreak High Contrast",
				"uiTheme": "hc-light",
				"path": "./theme/satellite-daybreak-hc.json"
			}
		]
	},
	"devDependencies": {
		"js-yaml": "^4.1.0",
		"prettier": "^3.3.3"
	}
}
